{
	"name": "extera_plugins",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build --webpack",
		"check": "biome check src scripts infra next.config.js postcss.config.js drizzle.config.ts package.json tsconfig.json components.json biome.jsonc",
		"check:unsafe": "biome check --write --unsafe src scripts infra next.config.js postcss.config.js drizzle.config.ts package.json tsconfig.json components.json biome.jsonc",
		"check:write": "biome check --write src scripts infra next.config.js postcss.config.js drizzle.config.ts package.json tsconfig.json components.json biome.jsonc",
		"db:cleanup": "tsx scripts/cleanup-only.ts",
		"db:fix-slugs": "tsx scripts/fix-plugin-slugs.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:safe": "tsx scripts/migrate-with-cleanup.ts",
		"db:migrate:production": "tsx scripts/cleanup-only.ts && drizzle-kit push",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dev": "next dev",
		"dev:turbo": "next dev --turbo",
		"build:webpack": "next build --webpack",
		"preview": "next build --webpack && next start",
		"start": "next start",
		"test:unit": "node --import tsx --test src/server/lib/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
